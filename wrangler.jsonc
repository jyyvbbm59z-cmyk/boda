{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boda",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // La web (public/) la sirve Cloudflare directamente; el Worker entra primero
  // en la portada (para meter los textos de src/config.js) y en la API.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/*", "/telegram/*", "/calendar.ics"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boda",
      // Sustituir por el id que devuelve: npx wrangler d1 create boda
      "database_id": "bfea2ab5-a6fd-4269-b9ef-9d9067c49dbc",
      "migrations_dir": "migrations"
    }
  ],

  // Límite de peticiones por IP para que nadie pruebe códigos a ciegas
  "ratelimits": [
    { "name": "RL", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],

  // Descomenta y pon tu subdominio cuando lo tengas
  // "routes": [{ "pattern": "boda.tudominio.es", "custom_domain": true }],

  "vars": {
    // URL pública de la web, para los enlaces de invitación y el bot
    "PUBLIC_URL": "https://boda.tudominio.es"
  }
  // Secretos (npx wrangler secret put NOMBRE):
  //   TELEGRAM_BOT_TOKEN       token de @BotFather
  //   TELEGRAM_CHAT_ID         id del chat (o varios separados por comas)
  //   TELEGRAM_WEBHOOK_SECRET  cadena aleatoria para validar el webhook
  //   RSVP_CODE                el código de la invitación (uno para todos)
}
